generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                     String                 @id @default(uuid())
  name                   String
  priceInCents           Int
  type                   ProductType            // Use enum for product type
  filePath               String?                // For digital products, path to file
  imagePath              String?
  description            String
  stockQuantity          Int?                   // Only for physical products
  isAvailableForPurchase Boolean                @default(true)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  orders                 Order[]
  downloadVerifications  DownloadVerification[]
  images                 ProductImage[]         // Relation to multiple images
  sizes                  Size[]                 @relation("ProductSizes")  // Only for physical products
  colors                 Color[]                @relation("ProductColors") // Only for physical products
  categories             Category[]             @relation("ProductCategories") // Can be used for both
  subCategories          SubCategory[]          @relation("ProductSubCategories") // New relation to subcategories
  isFeatured             Boolean                @default(false)
  wishlistItems          WishlistItem[]

  @@index([name])
  @@index([priceInCents])
  @@index([isAvailableForPurchase])
}

model ProductImage {
  id        String   @id @default(uuid())
  imagePath String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Size {
  id        String    @id @default(uuid())
  name      String    // e.g., "SM", "M", "L", "XL"
  products  Product[] @relation("ProductSizes")
}

model Color {
  id        String    @id @default(uuid())
  name      String
  products  Product[] @relation("ProductColors")
}

model Category {
  id        String    @id @default(uuid())
  name      String
  parentId  String?
  parent    Category? @relation("SubCategories", fields: [parentId], references: [id])
  children  Category[] @relation("SubCategories")
  products  Product[] @relation("ProductCategories")
  subCategories SubCategory[] @relation("CategorySubCategories") // New relation to subcategories
}

model SubCategory { // New model for subcategories
  id        String    @id @default(uuid())
  name      String
  categoryId String
  category  Category  @relation("CategorySubCategories", fields: [categoryId], references: [id], onDelete: Cascade)
  products  Product[] @relation("ProductSubCategories")

  @@index([categoryId])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  clerkId   String   @unique
  imageUrl  String
  name      String?
  admin     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  wishlistItems WishlistItem[]
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id               String   @id @default(uuid())
  pricePaidInCents Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  userId           String
  productId        String
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product          Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([userId, productId])
}

model DownloadVerification {
  id        String   @id @default(uuid())
  expiresAt DateTime
  createdAt DateTime @default(now())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Enum to differentiate between product types
enum ProductType {
  PHYSICAL
  DIGITAL
}